{
  "name": "@businessos/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @businessos/execution-context build && pnpm --filter @businessos/file-jobs build && pnpm --filter @businessos/telemetry build && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm run build && node --watch dist/main.js",
    "start": "node dist/main.js",
    "test:unit": "pnpm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "testMatch": ["<rootDir>/tests/**/*.test.mjs"],
    "transform": {}
  },
  "dependencies": {
    "@businessos/execution-context": "workspace:*",
    "@businessos/file-jobs": "workspace:*",
    "@businessos/telemetry": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "bullmq": "5.81.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@businessos/config": "workspace:*",
    "@jest/globals": "30.5.2",
    "jest": "30.5.2"
  }
}
