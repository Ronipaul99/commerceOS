{
  "openapi": "3.1.0",
  "info": {
    "title": "BusinessOS internal HTTP contract",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Read the verified principal's identifier",
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ContractError"
          },
          "413": {
            "$ref": "#/components/responses/ContractError"
          },
          "415": {
            "$ref": "#/components/responses/ContractError"
          },
          "503": {
            "$ref": "#/components/responses/ContractError"
          },
          "default": {
            "$ref": "#/components/responses/ContractError"
          }
        },
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "$ref": "#/components/headers/RequestId/schema"
            }
          }
        ]
      }
    },
    "/api/v1/me/memberships": {
      "get": {
        "operationId": "listMemberships",
        "summary": "List only the verified principal's memberships",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,256}$"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "$ref": "#/components/headers/RequestId/schema"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ContractError"
          },
          "401": {
            "$ref": "#/components/responses/ContractError"
          },
          "413": {
            "$ref": "#/components/responses/ContractError"
          },
          "415": {
            "$ref": "#/components/responses/ContractError"
          },
          "503": {
            "$ref": "#/components/responses/ContractError"
          },
          "default": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/file-intents": {
      "post": {
        "operationId": "createFileIntent",
        "summary": "Create an authorized private upload intent",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileIntentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileIntent"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ContractError"
          },
          "401": {
            "$ref": "#/components/responses/ContractError"
          },
          "403": {
            "$ref": "#/components/responses/ContractError"
          },
          "404": {
            "$ref": "#/components/responses/ContractError"
          },
          "409": {
            "$ref": "#/components/responses/ContractError"
          },
          "413": {
            "$ref": "#/components/responses/ContractError"
          },
          "415": {
            "$ref": "#/components/responses/ContractError"
          },
          "503": {
            "$ref": "#/components/responses/ContractError"
          },
          "default": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/files/{fileId}/content": {
      "put": {
        "operationId": "uploadFileContent",
        "summary": "Upload bounded private file content",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileJob"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ContractError"
          },
          "401": {
            "$ref": "#/components/responses/ContractError"
          },
          "403": {
            "$ref": "#/components/responses/ContractError"
          },
          "404": {
            "$ref": "#/components/responses/ContractError"
          },
          "409": {
            "$ref": "#/components/responses/ContractError"
          },
          "413": {
            "$ref": "#/components/responses/ContractError"
          },
          "415": {
            "$ref": "#/components/responses/ContractError"
          },
          "503": {
            "$ref": "#/components/responses/ContractError"
          },
          "default": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/files/{fileId}/download-link": {
      "post": {
        "operationId": "createFileDownloadLink",
        "summary": "Issue an expiring private file grant",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileDownloadLink"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ContractError"
          },
          "401": {
            "$ref": "#/components/responses/ContractError"
          },
          "403": {
            "$ref": "#/components/responses/ContractError"
          },
          "404": {
            "$ref": "#/components/responses/ContractError"
          },
          "409": {
            "$ref": "#/components/responses/ContractError"
          },
          "503": {
            "$ref": "#/components/responses/ContractError"
          },
          "default": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/files/{fileId}/download": {
      "get": {
        "operationId": "downloadFile",
        "summary": "Redeem a signed private file grant",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "grant",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 57
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ContractError"
          },
          "401": {
            "$ref": "#/components/responses/ContractError"
          },
          "403": {
            "$ref": "#/components/responses/ContractError"
          },
          "404": {
            "$ref": "#/components/responses/ContractError"
          },
          "503": {
            "$ref": "#/components/responses/ContractError"
          },
          "default": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/file-jobs/{jobId}": {
      "get": {
        "operationId": "getFileJob",
        "summary": "Read the authorized file job state",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileJob"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ContractError"
          },
          "401": {
            "$ref": "#/components/responses/ContractError"
          },
          "403": {
            "$ref": "#/components/responses/ContractError"
          },
          "404": {
            "$ref": "#/components/responses/ContractError"
          },
          "503": {
            "$ref": "#/components/responses/ContractError"
          },
          "default": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/file-jobs/{jobId}/cancel": {
      "post": {
        "operationId": "cancelFileJob",
        "summary": "Cancel a file job by version",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileJob"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ContractError"
          },
          "401": {
            "$ref": "#/components/responses/ContractError"
          },
          "403": {
            "$ref": "#/components/responses/ContractError"
          },
          "404": {
            "$ref": "#/components/responses/ContractError"
          },
          "409": {
            "$ref": "#/components/responses/ContractError"
          },
          "503": {
            "$ref": "#/components/responses/ContractError"
          },
          "default": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "RequestId": {
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        }
      },
      "ETag": {
        "description": "Strong entity version returned by an operation that exposes a resource version.",
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]{0,15}\"$"
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "ContractError": {
        "description": "Versioned API error",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "Membership": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "tenantId"
        ],
        "additionalProperties": false
      },
      "MembershipPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ],
        "additionalProperties": false
      },
      "FileIntentInput": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 5,
            "maxLength": 100
          },
          "mediaType": {
            "type": "string",
            "const": "text/plain"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          }
        },
        "required": [
          "filename",
          "mediaType",
          "sizeBytes"
        ],
        "additionalProperties": false
      },
      "FileIntent": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "INTENT",
              "QUARANTINED",
              "AVAILABLE",
              "REJECTED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "fileId",
          "state",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "FileUploadInput": {
        "type": "object",
        "properties": {
          "contentBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "minLength": 4,
            "maxLength": 21848
          }
        },
        "required": [
          "contentBase64"
        ],
        "additionalProperties": false
      },
      "FileDownloadLink": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "FileJob": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "SUCCEEDED",
              "REJECTED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "failure": {
            "enum": [
              "SCAN_REJECTED",
              "SCAN_UNAVAILABLE",
              null
            ]
          }
        },
        "required": [
          "jobId",
          "state",
          "progress",
          "version",
          "failure"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Required on idempotency-enabled writes. Scope keys to principal, tenant and operation.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~:-]{1,128}$"
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "Current strong resource version for optimistic concurrency.",
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]{0,15}\"$"
        }
      }
    }
  }
}
