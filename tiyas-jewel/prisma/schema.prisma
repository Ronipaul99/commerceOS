generator client {
  provider = "prisma-client"
  output = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique @db.VarChar(120)
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  products    Product[]
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique @db.VarChar(120)
  description String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  products    ProductCollection[]
}

model Product {
  orderItems    OrderItem[]
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique @db.VarChar(120)
  description   String
  pricePaise    Int
  compareAtPaise Int?
  sku           String? @unique
  featured      Boolean @default(false)
  stockQuantity Int                 @default(0)
  active        Boolean             @default(true)
  categoryId    String
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  collections   ProductCollection[]
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  @@index([active, createdAt, id])
  @@index([categoryId])
  @@index([active, featured])
}

model ProductImage {
  assetId   String? @unique @db.Uuid
  asset     ImageAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  concept   Boolean @default(false)
  variantImages ProductVariant[] @relation("VariantImage")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([productId, position])
  @@unique([id, productId])
}

model ProductVariant {
  orderItems    OrderItem[]
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String   @unique
  pricePaise    Int?
  imageId       String?
  image         ProductImage? @relation("VariantImage", fields: [imageId, productId], references: [id, productId], onDelete: NoAction)
  stockQuantity Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([productId, active])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model AdminUser {
  sessions     AdminSession[]
  imageAssets  ImageAsset[]
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}



enum PaymentMethod {
  ONLINE
  COD
}
enum PaymentState {
  PENDING
  PAID
  FAILED
  COD_PENDING
}
enum OperationalState {
  NEW
  COMPLETED
}
enum ReservationState {
  HELD
  FINALIZED
  RELEASED
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  idempotencyKey String @unique @db.Uuid
  requestHash String @db.Char(64)
  tokenHash String @unique @db.Char(64)
  customerName String @db.VarChar(100)
  customerEmail String @db.VarChar(254)
  customerMobile String @db.VarChar(10)
  address Json
  currency String @default("INR") @db.VarChar(3)
  subtotalPaise Int
  shippingPaise Int
  taxPaise Int
  discountPaise Int @default(0)
  totalPaise Int
  taxMode String
  taxBps Int
  paymentMethod PaymentMethod
  paymentStatus PaymentState
  operationalStatus OperationalState?
  accepted Boolean @default(false)
  needsReview Boolean @default(false)
  reservationState ReservationState
  reservationExpiresAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  items OrderItem[]
  payment Payment?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([accepted, operationalStatus, createdAt])
  @@index([reservationState, reservationExpiresAt])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  productVariant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  slug String
  name String
  variant String?
  sku String?
  image String?
  concept Boolean @default(false)
  quantity Int
  unitPricePaise Int
  lineTotalPaise Int
  position Int
  @@unique([orderId, position])
  @@index([productId])
  @@index([variantId])
}

model AdminSession {
  id String @id @default(cuid())
  tokenHash String @unique @db.Char(64)
  adminId String
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([adminId])
  @@index([expiresAt])
}

model ImageAsset {
  id String @id @db.Uuid
  objectKey String @unique
  width Int
  height Int
  bytes Int
  uploaderId String
  uploader AdminUser @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  image ProductImage?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model Payment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  adapter String
  gatewayOrderId String? @unique
  gatewayPaymentId String? @unique
  status PaymentState
  amountPaise Int
  currency String @default("INR")
  initiationStartedAt DateTime? @db.Timestamptz(3)
  verificationMetadata Json?
  verifiedAt DateTime? @db.Timestamptz(3)
  lastReconciledAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([status, lastReconciledAt])
}
model PaymentWebhook {
  eventId String @id
  bodyHash String @db.Char(64)
  eventType String
  processedAt DateTime @default(now()) @db.Timestamptz(3)
}
