generator client {
  provider = "prisma-client"
  output = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique @db.VarChar(120)
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  products    Product[]
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique @db.VarChar(120)
  description String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  products    ProductCollection[]
}

model Product {
  reviews       CustomerReview[]
  reelProducts  ReelProduct[]
  orderItems    OrderItem[]
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique @db.VarChar(120)
  description   String
  details       Json?
  pricePaise    Int
  compareAtPaise Int?
  sku           String? @unique
  featured      Boolean @default(false)
  stockQuantity Int                 @default(0)
  active        Boolean             @default(true)
  categoryId    String
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  collections   ProductCollection[]
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  @@index([active, createdAt, id])
  @@index([categoryId])
  @@index([active, featured])
}

model ProductImage {
  assetId   String? @unique @db.Uuid
  asset     ImageAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  concept   Boolean @default(false)
  variantImages ProductVariant[] @relation("VariantImage")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([productId, position])
  @@unique([id, productId])
}

model ProductVariant {
  orderItems    OrderItem[]
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String   @unique
  pricePaise    Int?
  imageId       String?
  image         ProductImage? @relation("VariantImage", fields: [imageId, productId], references: [id, productId], onDelete: NoAction)
  stockQuantity Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([productId, active])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model AdminUser {
  name         String   @default("") @db.VarChar(100)
  role         AdminRole @default(OWNER)
  invited      Boolean @default(false)
  otps         AdminOtp[]
  sessions     AdminSession[]
  imageAssets  ImageAsset[]
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}



enum PaymentMethod {
  ONLINE
  COD
}
enum PaymentState {
  PENDING
  PAID
  FAILED
  COD_PENDING
}
enum OperationalState {
  NEW
  COMPLETED
}
enum ReservationState {
  HELD
  FINALIZED
  RELEASED
}

model Order {
  couponRedemption CouponRedemption?
  couponCode String? @db.VarChar(32)
  couponSnapshot Json?
  id String @id @default(cuid())
  orderNumber String @unique
  idempotencyKey String @unique @db.Uuid
  requestHash String @db.Char(64)
  tokenHash String @unique @db.Char(64)
  customerName String @db.VarChar(100)
  customerEmail String @db.VarChar(254)
  customerMobile String @db.VarChar(10)
  address Json
  currency String @default("INR") @db.VarChar(3)
  subtotalPaise Int
  shippingPaise Int
  taxPaise Int
  discountPaise Int @default(0)
  totalPaise Int
  taxMode String
  taxBps Int
  paymentMethod PaymentMethod
  paymentStatus PaymentState
  operationalStatus OperationalState?
  accepted Boolean @default(false)
  needsReview Boolean @default(false)
  reservationState ReservationState
  reservationExpiresAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  items OrderItem[]
  payment Payment?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([accepted, operationalStatus, createdAt])
  @@index([reservationState, reservationExpiresAt])
}
model OrderItem {
  discountPaise Int @default(0)
  reviews CustomerReview[]
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  productVariant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  slug String
  name String
  variant String?
  sku String?
  image String?
  concept Boolean @default(false)
  quantity Int
  unitPricePaise Int
  lineTotalPaise Int
  position Int
  @@unique([orderId, position])
  @@index([productId])
  @@index([variantId])
}

model AdminSession {
  id String @id @default(cuid())
  tokenHash String @unique @db.Char(64)
  adminId String
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([adminId])
  @@index([expiresAt])
}

model ImageAsset {
  sourceHash String? @db.Char(64)
  renditions ImageRendition[]
  stories CustomerStory[]
  reelPosters Reel[]
  contentUses ContentAssetUse[]
  id String @id @db.Uuid
  objectKey String
  width Int
  height Int
  bytes Int
  uploaderId String
  uploader AdminUser @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  image ProductImage?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([objectKey])
  @@index([uploaderId, sourceHash])
}

// Guest feedback shares verification/moderation while PRODUCT and STORE aggregates stay separate.
model CustomerReview {
  id String @id @default(cuid())
  kind String @db.VarChar(10)
  subjectKey String
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  emailKey String @db.Char(64)
  email String @db.VarChar(254)
  displayName String @db.VarChar(80)
  title String @default("") @db.VarChar(120)
  text String @db.VarChar(3000)
  rating Int?
  status String @default("PENDING") @db.VarChar(12)
  orderItemId String?
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  verifiedPurchase Boolean @default(false)
  consentAt DateTime @db.Timestamptz(3)
  consentVersion String @db.VarChar(30)
  moderatedBy String?
  moderationReason String @default("") @db.VarChar(500)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  stories CustomerStory[]
  @@unique([emailKey, subjectKey])
  @@index([kind, status, createdAt, id])
  @@index([productId, status, createdAt, id])
}

model ReviewChallenge {
  id String @id @default(uuid()) @db.Uuid
  emailKey String @db.Char(64)
  email String @db.VarChar(254)
  subjectKey String
  codeHash String @db.Char(64)
  grantHash String? @unique @db.Char(64)
  submissionHash String? @db.Char(64)
  submittedReviewId String?
  attempts Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  usedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([emailKey, subjectKey])
  @@index([expiresAt])
}

model CustomerStory {
  id String @id @default(cuid())
  title String @db.VarChar(160)
  caption String @db.VarChar(2000)
  displayName String @db.VarChar(80)
  reviewId String?
  review CustomerReview? @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  imageAssetId String? @db.Uuid
  image ImageAsset? @relation(fields: [imageAssetId], references: [id], onDelete: Restrict)
  alt String @default("") @db.VarChar(300)
  productIds String[] @default([])
  consentEvidence String @db.VarChar(2000)
  consentAt DateTime @db.Timestamptz(3)
  published Boolean @default(false)
  position Int @default(0)
  updatedBy String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([published, position, id])
}

model Coupon {
  id String @id @default(cuid())
  code String @unique @db.VarChar(32)
  description String @default("") @db.VarChar(300)
  type String @db.VarChar(10)
  value Int
  minimumPaise Int @default(0)
  maximumDiscountPaise Int?
  usageLimit Int?
  perCustomerLimit Int?
  productIds String[] @default([])
  categoryIds String[] @default([])
  collectionIds String[] @default([])
  paymentMethods String[] @default(["ONLINE", "COD"])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  active Boolean @default(false)
  archived Boolean @default(false)
  version Int @default(1)
  updatedBy String
  redemptions CouponRedemption[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model CouponRedemption {
  id String @id @default(cuid())
  couponId String
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  emailKey String @db.Char(64)
  state String @db.VarChar(10)
  amountPaise Int
  expiresAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([couponId, state, expiresAt])
  @@index([couponId, emailKey, state])
}

model Reel {
  id String @id @default(cuid())
  title String @db.VarChar(160)
  caption String @default("") @db.VarChar(2000)
  transcript String @default("") @db.VarChar(5000)
  posterId String @db.Uuid
  poster ImageAsset @relation(fields: [posterId], references: [id], onDelete: Restrict)
  instagramUrl String @db.VarChar(100)
  published Boolean @default(false)
  rightsConfirmed Boolean @default(false)
  position Int @default(0)
  version Int @default(1)
  updatedBy String
  products ReelProduct[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([published, position, id])
}

model ReelProduct {
  reelId String
  productId String
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  position Int @default(0)
  @@id([reelId, productId])
}

model ImageRendition {
  contentHash String? @db.Char(64)
  id String @id @default(cuid())
  assetId String @db.Uuid
  asset ImageAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  width Int
  height Int
  bytes Int
  objectKey String
  version Int @default(1)
  @@unique([assetId, width, version])
  @@index([objectKey])
}

model MediaPurgeEvent {
  id BigInt @id @default(autoincrement())
  paths String[]
  attempts Int @default(0)
  nextAttemptAt DateTime @db.Timestamptz(3)
  leaseUntil DateTime? @db.Timestamptz(3)
  leaseToken String? @db.Uuid
  lastError String? @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([nextAttemptAt, id])
}

enum AdminRole {
  OWNER
  ADMIN
  CONTENT_MANAGER
}
model AdminOtp {
  id String @id @default(uuid()) @db.Uuid
  adminId String
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purpose String @db.VarChar(10)
  codeHash String @db.Char(64)
  attempts Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([adminId, purpose])
}
model ContentDocument {
  key String @id @db.VarChar(130)
  draft Json
  published Json?
  version Int @default(1)
  publishedAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  assets ContentAssetUse[]
}
model ContentAssetUse {
  documentKey String @db.VarChar(130)
  document ContentDocument @relation(fields: [documentKey], references: [key], onDelete: Cascade, onUpdate: NoAction)
  assetId String @db.Uuid
  asset ImageAsset @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  published Boolean
  @@id([documentKey, assetId, published])
  @@index([assetId, published])
}
model Payment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  adapter String
  gatewayOrderId String? @unique
  gatewayPaymentId String? @unique
  status PaymentState
  amountPaise Int
  currency String @default("INR")
  initiationStartedAt DateTime? @db.Timestamptz(3)
  verificationMetadata Json?
  verifiedAt DateTime? @db.Timestamptz(3)
  lastReconciledAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([status, lastReconciledAt])
}
model PaymentWebhook {
  eventId String @id
  bodyHash String @db.Char(64)
  eventType String
  processedAt DateTime @default(now()) @db.Timestamptz(3)
}
