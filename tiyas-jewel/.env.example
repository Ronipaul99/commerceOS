# Copy to .env. Never commit real credentials. These placeholders are not usable secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# API runtime only; Next.js must never receive this value.
DATABASE_URL=postgresql://tiyas:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/tiyas_jewel?schema=public
# Optional direct migration URL (e.g. when runtime uses a connection pooler).
# DIRECT_DATABASE_URL=postgresql://...
# Server-only upstream used by Next.js rewrites; never NEXT_PUBLIC_.
API_INTERNAL_URL=http://127.0.0.1:4000
# Docker Compose: use a URL-safe random password, matching DATABASE_URL for host development.
POSTGRES_USER=tiyas
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=tiyas_jewel

# Optional test-only URLs; choose a separate dedicated migrated/seeded database.
# TEST_DATABASE_URL=postgresql://tiyas:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:5433/tiyas_test
# E2E_DATABASE_URL=postgresql://tiyas:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:5433/tiyas_test

# Stage 04 guest checkout (all money values are integer INR paise).
# Auto-selects the development simulator only outside production when keys are absent.
# Production defaults to disabled. Development adapter is forbidden in production.
# PAYMENT_ADAPTER=development
# Razorpay integration currently accepts TEST keys only; leave all three blank if unused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COD_ENABLED=false
SHIPPING_FEE_PAISE=9900
FREE_SHIPPING_THRESHOLD_PAISE=199900
# Empty permits all syntactically valid Indian PIN codes; otherwise exact comma-separated allowlist.
SERVICEABLE_PIN_CODES=
# Goods-only tax; shipping fee is final. Set approved merchant tax policy before launch.
TAX_MODE=inclusive
TAX_BPS=0
RESERVATION_MINUTES=15

# Stage 05 admin sessions: secure host-only cookies in production; HTTPS required.
ADMIN_SESSION_HOURS=8
# Local delivery adapter for development. Production: oci + private bucket.
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=var/uploads
# OCI S3 Compatibility endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ENDPOINT=
OCI_REGION=
OCI_BUCKET=
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
# No default admin password. npm run admin:create prompts securely.
# Non-interactive provisioning accepts ADMIN_EMAIL / ADMIN_PASSWORD from the process environment.
